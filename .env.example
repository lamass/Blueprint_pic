# Template for .env -- copy to .env and fill in real values there.
# .env itself is gitignored and should never be committed or shared.

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Postgres -- same "market_data" database TickRecorder.cs (NinjaTrader) writes to.
# TickRecorder.cs itself reads its password from a Windows environment
# variable (POSTGRES_PASSWORD) instead of .env, since NinjaScript can't load
# .env files -- so you'll set the same password in two places. That's fine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
